###############################################################################
# GLOBAL .GITIGNORE
# By Dominique Mariano Castro
#
# A generic, all-purpose ignore file covering operating systems, editors/IDEs,
# and the most common programming languages, frameworks, and package managers.
# Sections are organized so unused ones can be safely deleted per project.
###############################################################################


###############################################################################
# OPERATING SYSTEMS
# Junk files automatically created by Windows, macOS, and Linux file explorers.
###############################################################################

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.DocumentRevisions-V100
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*


###############################################################################
# EDITORS & IDEs
# Editor/IDE-specific project and cache files.
###############################################################################

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains (IntelliJ IDEA, WebStorm, PyCharm, Rider, etc.)
.idea/
*.iws
*.iml
*.ipr
out/

# Eclipse
.settings/
.classpath
.project
.factorypath
bin/

# NetBeans
nbproject/
nbbuild/
nbdist/
nb-configuration.xml

# Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Vim / Emacs / Sublime
*.swp
*.swo
*.sublime-workspace
*.sublime-project
\#*\#
.\#*

# AI / editor assistants
.claude
.cursor/
.windsurf/
.aider*


###############################################################################
# BUILD OUTPUT & COMPILED ARTIFACTS
# Generic build directories and binaries produced by compilers/bundlers.
###############################################################################

build/
dist/
out/
bin/
obj/
target/
release/
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.class
*.jar
*.war
*.ear


###############################################################################
# LOGS, TEMP FILES & CACHES
# Runtime output that should never be committed.
###############################################################################

*.log
logs/
*.tmp
*.temp
*.bak
*.old
*.cache
.cache/
tmp/
temp/


###############################################################################
# ENVIRONMENT VARIABLES & SECRETS
# Local configuration and credentials that must never be pushed to a repo.
###############################################################################

.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.*
credentials.*


###############################################################################
# NODE.JS / JAVASCRIPT / TYPESCRIPT
###############################################################################

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnp.*
.next/
.nuxt/
.svelte-kit/
.output/
.vercel/
.netlify/
coverage/
*.tsbuildinfo


###############################################################################
# PYTHON
###############################################################################

__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.Python
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
pip-log.txt


###############################################################################
# JAVA / MAVEN / GRADLE
###############################################################################

.mvn/wrapper/maven-wrapper.jar
.gradle/
gradle-app.setting
!gradle-wrapper.jar


###############################################################################
# .NET / C#
###############################################################################

*.pdb
*.cache
project.lock.json
project.fragment.lock.json
artifacts/


###############################################################################
# GO
###############################################################################

*.test
*.out
vendor/


###############################################################################
# RUST
###############################################################################

/target/
Cargo.lock


###############################################################################
# RUBY
###############################################################################

*.gem
.bundle/
vendor/bundle/


###############################################################################
# PHP
###############################################################################

vendor/
composer.phar


###############################################################################
# MOBILE (ANDROID / iOS / SWIFT)
###############################################################################

*.apk
*.aab
*.ipa
*.dSYM.zip
Pods/
DerivedData/
*.xcuserstate


###############################################################################
# ARCHIVES & MISC
# Compressed files people occasionally forget to exclude from source control.
###############################################################################

*.zip
*.tar
*.tar.gz
*.rar
*.7z
